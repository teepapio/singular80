# Optional: Discord-Webhook (kann auch im Dashboard unter Einstellungen eingetragen werden)
DISCORD_WEBHOOK_URL=

# Optional: Telegram. Wird der Bot in Telegram nicht zugestellt, ist fast immer
# die Ursache, dass der Bot noch keine Nachricht vom eigenen Konto bekommen hat
# — ein Bot darf niemandem zuerst schreiben. Einmal dem Bot in Telegram
# schreiben, dann funktioniert es.
#   Token: bei @BotFather anlegen ("/newbot") — er hat 35 Zeichen nach dem ":"
#   Chat-ID: bei @userinfobot nachfragen
# Beide Werte gehören hierher und nicht ins Dashboard: ein Bot-Token ist der
# Schlüssel zum ganzen Bot, kein Kanal-Webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Wer Befehle ausführen darf, durch Komma getrennt. Ohne einen dieser Werte
# reagiert der Bot auf KEINEN Befehl — ein Run startet eine OpenCode-Sitzung im
# Arbeitsbaum, deshalb ist die Sperre keine Formalität. Standard ist die
# Chat-ID oben; in Gruppen ist die Benutzer-ID die richtige Angabe.
TELEGRAM_ALLOWED_USER_IDS=

# Port des Backends
PORT=8787

# Bind-Adresse. 0.0.0.0 nötig, damit Handy und Tablet den Server erreichen;
# 127.0.0.1 reicht nur auf diesem Rechner. Die API ist nicht angemeldet —
# in fremden Netzen daher 127.0.0.1 lassen.
HOST=0.0.0.0

# URL, die in Discord-Nachrichten verlinkt wird
DASHBOARD_URL=http://localhost:5173/dashboard.html
