{
  "name": "singular80",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/sync-content.mjs --check && node scripts/locale.mjs check && vitest run",
    "test:game": "node scripts/test-game.mjs",
    "scopes": "node scripts/scopes.mjs list",
    "scopes:check": "node scripts/scopes.mjs list",
    "backup": "tsx scripts/backup.ts",
    "changelog": "tsx scripts/changelog.ts",
    "smoke": "tsx scripts/smoke.ts",
    "godot:import": "node scripts/sync-content.mjs && node scripts/locale.mjs sync && godot --headless --path godot --import",
    "godot:check": "godot --headless --path godot --quit-after 240",
    "godot:apk": "node scripts/install-android-template.mjs && godot --headless --path godot --export-debug \"Android\"",
    "godot:apk:release": "node scripts/install-android-template.mjs && godot --headless --path godot --export-release \"Android\"",
    "content:sync": "node scripts/sync-content.mjs",
    "content:check": "node scripts/sync-content.mjs --check",
    "godot:android-template": "node scripts/install-android-template.mjs",
    "locale:sync": "node scripts/locale.mjs sync",
    "locale:check": "node scripts/locale.mjs check",
    "locale:list": "node scripts/locale.mjs list",
    "locale:lock": "node scripts/locale.mjs lock"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
